	measure 'Test Except' = COUNTROWS(EXCEPT(VALUES('fact vMarketingSpend'[AcquisitionChannelKey]), VALUES('dim vAcquisitionChannel'[AcquisitionChannelKey])))
		formatString: 0
		displayFolder: Tries & tests
		lineageTag: 4f5920af-7a0b-47a3-b08c-61152c52faa9

	measure 'CLV by channel' = ```
			
			    var customersByChannel = COUNTX('fact vCustomerAcquisition','fact vCustomerAcquisition'[AcquisitionChannelKey])
			return DIVIDE([Online Revenue],customersByChannel)
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: CFO\Customers
		lineageTag: 5a9e601d-63e7-42ad-bcc3-f7d58c03ee3d

