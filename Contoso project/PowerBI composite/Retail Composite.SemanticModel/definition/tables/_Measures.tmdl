		lineageTag: 2bfed917-cc45-4ab2-8059-02dd9bbdc87e

	measure 'CAC To CLVChannel Ratio' = DIVIDE([CAC],[CLV by channel])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Tries & tests
