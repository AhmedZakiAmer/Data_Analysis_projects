	measure 'Total discount quantity' = SUM('fact vOnlineSales'[DiscountQuantity]) + SUM('fact vStoreSales'[DiscountQuantity])
		formatString: 0
		displayFolder: CFO\Others
		lineageTag: 61f6e508-f09a-48d5-a364-73e4a8043470

	measure 'Waterfall Value' =
			
			SWITCH(
			    SELECTEDVALUE('Waterfall Steps'[Step]),
			
			    "Budget", -[Total Revenue],
			
			    "Discount", [Total Discount Amount],
			
			    "Returns", [Total Return Amounts],
			
			    "Actual", -[Total Net Rev]
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Tries & tests
		lineageTag: 33de7cbb-59cc-457f-b247-76a9b849e8ec

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

